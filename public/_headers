# HTML and unhashed files must be revalidated on each visit.
/*
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: no-cache, must-revalidate

# Vite content-hashed JS, CSS and generated lookup files.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable

# Content-addressed WebP images, independent of application releases.
/assets/ggstarrail/webp/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets have stable, unhashed URLs.
/logo-*.svg
  Cache-Control: no-cache, must-revalidate

/favicon*
  Cache-Control: no-cache, must-revalidate

/apple-touch-icon.png
  Cache-Control: no-cache, must-revalidate

# GOODCapture refreshes this stable endpoint independently of app releases.
/good/hsr_data_cache.json
  Cache-Control: no-cache, must-revalidate
