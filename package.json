{
  "name": "ggstarrail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "dev:wrangler": "npm run dev:worker",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "data:sync": "node scripts/sync-hsr-reference.mjs",
    "data:verify": "node scripts/sync-hsr-reference.mjs --verify-only",
    "data:check": "node scripts/sync-hsr-reference.mjs --check-generated",
    "data:website:check": "node scripts/check-game-data.mjs",
    "assets:sync": "node scripts/sync-hsr-assets.mjs",
    "assets:verify": "node scripts/sync-hsr-assets.mjs --verify-only",
    "assets:check": "node scripts/sync-hsr-assets.mjs --check-generated",
    "assets:webp": "node scripts/prepare-web-assets.mjs",
    "data:restore": "node scripts/data-bundle.mjs restore",
    "data:package": "node scripts/data-bundle.mjs package",
    "data:update": "node scripts/update-data.mjs",
    "build:cloudflare": "npm run data:restore && npm run assets:webp && npm run check",
    "deploy": "wrangler deploy",
    "build": "npm run assets:webp && tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "type-check:worker": "tsc -p tsconfig.worker.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:data-sources": "node --test scripts/crawl-sources.test.mjs",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcheck": "depcruise src tests worker --config .dependency-cruiser.cjs",
    "check:worker-config": "node scripts/check-worker-config.mjs",
    "check:worker": "npm run check:worker-config && npm run type-check:worker && npm run test:worker",
    "check": "npm run data:check && npm run assets:check && npm run data:website:check && npm run test:data-sources && npm run type-check && npm run lint && npm run test && npm run depcheck && npm run build && npm run check:worker"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^17.3.10",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.18",
    "tar": "^7.5.22",
    "typescript": "^5.8.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.5",
    "wrangler": "4.127.1"
  }
}
