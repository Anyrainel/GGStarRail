{
  "name": "ggstarrail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:tooling": "node --test scripts/git-hooks.test.mjs scripts/dependency-rules.test.mjs scripts/architecture-layout.test.mjs",
    "dev": "vite",
    "demo:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "dev:wrangler": "npm run dev:worker",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "data:sync": "node scripts/sync-hsr-reference.mjs",
    "data:verify": "node scripts/sync-hsr-reference.mjs --verify-only",
    "data:check": "node scripts/sync-hsr-reference.mjs --check-generated",
    "data:website:check": "node scripts/check-game-data.mjs",
    "assets:sync": "node scripts/sync-hsr-assets.mjs",
    "assets:verify": "node scripts/sync-hsr-assets.mjs --verify-only",
    "assets:check": "node scripts/sync-hsr-assets.mjs --check-generated",
    "assets:webp": "node scripts/prepare-web-assets.mjs",
    "data:restore": "node scripts/data-bundle.mjs restore",
    "data:package": "node scripts/data-bundle.mjs package",
    "build:cloudflare": "npm run data:restore && npm run assets:webp && npm run check",
    "deploy": "wrangler deploy",
    "build": "npm run assets:webp && tsc -b && vite build && node scripts/check-home-assets.mjs && node scripts/check-public-assets.mjs",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "type-check:worker": "tsc -p tsconfig.worker.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:data-sources": "node --test scripts/crawl-sources.test.mjs scripts/validate-current-reference.test.mjs",
    "test:worker": "vitest run -c vitest.worker.config.ts && vitest run -c vitest.worker-runtime.config.ts",
    "types:worker": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv && node scripts/normalize-worker-types.mjs",
    "check:worker-types": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv --check",
    "styles:generate": "node scripts/generate-game-palette.mjs",
    "styles:check": "node scripts/generate-game-palette.mjs --check",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "depcheck": "depcruise src tests worker --config .dependency-cruiser.cjs",
    "check:worker-config": "node scripts/check-worker-config.mjs",
    "check:worker": "npm run check:worker-config && npm run check:worker-types && npm run type-check:worker && npm run test:worker",
    "check": "npm run styles:check && npm run data:check && npm run assets:check && npm run data:website:check && npm run test:data-sources && npm run test:tooling && npm run type-check && npm run lint && npm run test && npm run depcheck && npm run build && npm run check:worker",
    "combat:dossier": "node scripts/combat-dossier.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@logto/browser": "3.1.0",
    "@logto/react": "4.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-to-image": "1.11.13",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6",
    "zustand": "5.0.15",
    "radix-ui": "1.8.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@playwright/test": "1.64.0",
    "postcss": "8.5.29",
    "@babel/parser": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.6.0",
    "jsdom": "30.1.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0",
    "@tailwindcss/vite": "4.3.3",
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "tw-animate-css": "1.4.0",
    "msw": "3.0.3",
    "@msw/cloudflare": "0.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
